{
  "$schema": "https://dshmini.local/schema/tokens.json",
  "version": 10,
  "meta": {
    "note": "DSHmini 设计 token 唯一事实源（docs/UI-SPEC.md §1）。生成 Web 端 CSS Variables。手写数值即违规。v4：黑白主题（无强调色/品牌色），状态靠符号+亮度；仅 diff 增删保留绿红内容层语义色；图标库锁定 Lucide（stroke 1.5/round/单色 currentColor），语义映射见 UI-SPEC §1.6.1；暗色为默认。v5：圆角阶梯以 macOS 26 (Tahoe) 官方大圆角为锚——window 26 为系统工具栏类窗口圆角（壳层挂可见空 NSToolbar 触发、WindowServer 裁切，与 Finder/Notes 同款），panel 18 = 26−8 依 HIG 同心规则贴合窗口角，bubble 24 为聊天气泡软胶囊档，input 档并入 control/card；≤16px 的微型元素（徽标/复选标记/滚动条）允许按比例小圆角。v6：使用统计图表新增 chart 数据编码色（系列色 + 热力格五档），仅用于数据编码（与 diff 绿红同类的内容层例外），主题铬仍黑白。v7：新增 signal 组（warn/live/danger/effortFill）——此前散落 theme.css 的手写警示橙/运行青/危险红/亮色 effort 填充收编入表（AUD-091），同为内容层例外、非主题铬；light/dark 同值以保持既有视觉不变。v9：移除 signal.effortFill——思考强度滑杆改成档位菜单后它没有消费者（不必再为无主的填充色保留收编位）。v8：移除 shadow 与 motion 两组死数据——生成器从不输出、src 零消费（AUD-054）；阴影与动效值仍以 theme.css 手写为准。v10：font.size 改成 ZCode 口径的「一个基准 + 每档偏移」五档（xs/sm/base/lg/xl）＋显示级 hero，角色名沿用其 text-ui-* 语义；此前六档（caption/small/body/title/hero/input）生成出的是无单位裸数字（font-size 上 invalid-at-computed-value-time）且 src 零消费，实际字号是 theme.css 与各 module 手写的 13 种 px（含 12.5/11.5/13.5/10.5 四个半像素档）——本版一并收敛为消费这些 token。lineHeight/weight 与 tabularNums 移除：生成器从不输出、零消费，行高与字重按 ZCode 口径是逐规则的独立决定。",
    "source": "docs/UI-SPEC.md"
  },
  "icon": {
    "library": "lucide-react",
    "stroke": { "width": 1.5, "linecap": "round", "linejoin": "round", "fill": "none" },
    "color": { "default": "text.secondary", "active": "text.primary" }
  },
  "color": {
    "text": {
      "primary":   { "light": "#1A1A1A", "dark": "#F2F2F3" },
      "secondary": { "light": "#626262", "dark": "#9E9EA3" },
      "tertiary":  { "light": "#98989D", "dark": "#6E6E73" },
      "disabled":  { "light": "#C4C4C8", "dark": "#454548" }
    },
    "surface": {
      "panel":     { "light": "rgba(255,255,255,.72)", "dark": "rgba(14,14,16,.62)" },
      "raised":    { "light": "rgba(255,255,255,.88)", "dark": "rgba(34,34,38,.70)" },
      "input":     { "light": "rgba(0,0,0,.05)",       "dark": "rgba(255,255,255,.045)" },
      "selected":  { "light": "rgba(0,0,0,.10)",       "dark": "rgba(255,255,255,.14)" },
      "inverted":  { "light": "#FFFFFF",               "dark": "#2A2A2E" }
    },
    "border": {
      "default": { "light": "rgba(0,0,0,.11)",  "dark": "rgba(255,255,255,.09)" },
      "strong":  { "light": "rgba(0,0,0,.22)",  "dark": "rgba(255,255,255,.18)" },
      "gloss":   { "light": "rgba(255,255,255,.55)", "dark": "rgba(255,255,255,.16)" }
    },
    "focus": { "light": "#000000", "dark": "#FFFFFF" },
    "status": {
      "running": { "light": "#8A8A8E",  "dark": "#D8D8DC" },
      "waiting": { "light": "#1A1A1A",  "dark": "#F2F2F3" },
      "failed":  { "light": "#3A3A3E",  "dark": "#E4E4E8" },
      "done":    { "light": "#6E6E73",  "dark": "#9E9EA3" },
      "danger":  { "light": "#1A1A1A",  "dark": "#F2F2F3" }
    },
    "diff": {
      "add": { "light": "#0F7A3D", "dark": "#3FCC7A" },
      "del": { "light": "#C22F2F", "dark": "#E5534B" }
    },
    "signal": {
      "warn":       { "light": "#FF9F0A", "dark": "#FF9F0A" },
      "live":       { "light": "#7FDBCA", "dark": "#7FDBCA" },
      "danger":     { "light": "#E5484D", "dark": "#E5484D" }
    },
    "chart": {
      "series1": { "light": "#2E7FE0", "dark": "#4D9FFF" },
      "series2": { "light": "#27A05A", "dark": "#3FCC7A" },
      "series3": { "light": "#D97706", "dark": "#F5A623" },
      "series4": { "light": "#8E5CF7", "dark": "#A78BFA" },
      "series5": { "light": "#DB2777", "dark": "#F472B6" },
      "heat1":   { "light": "rgba(46,127,224,.22)", "dark": "rgba(77,159,255,.24)" },
      "heat2":   { "light": "rgba(46,127,224,.42)", "dark": "rgba(77,159,255,.44)" },
      "heat3":   { "light": "rgba(46,127,224,.62)", "dark": "rgba(77,159,255,.64)" },
      "heat4":   { "light": "rgba(46,127,224,.82)", "dark": "rgba(77,159,255,.84)" },
      "heat5":   { "light": "#2E7FE0", "dark": "#4D9FFF" }
    },
    "terminal": { "bg": { "light": "#F2F2F4", "dark": "#1A1A1D" } },
    "overlay":  { "scrim": { "light": "rgba(0,0,0,.35)", "dark": "rgba(0,0,0,.55)" } }
  },
  "font": {
    "ui": { "family": "-apple-system, \"PingFang SC\", \"SF Pro Text\", sans-serif" },
    "mono": { "family": "\"SF Mono\", ui-monospace, Menlo, monospace" },
    "base": { "px": 14 },
    "size": {
      "xs":   { "offset": -4 },
      "sm":   { "offset": -2 },
      "base": { "offset": 0 },
      "lg":   { "offset": 2 },
      "xl":   { "offset": 4 },
      "hero": { "px": 24 }
    }
  },
  "space": { "s1": 4, "s2": 8, "s3": 12, "s4": 16, "s5": 20, "s6": 24 },
  "radius": {
    "keycap": 6,
    "control": 10,
    "card": 14,
    "panel": 18,
    "floating": 20,
    "bubble": 24,
    "window": 26
  },
  "border": {
    "width": 1,
    "focus": { "width": 2, "color": "focus" }
  },
  "size": {
    "row": { "compact": 28, "standard": 36 },
    "sidebar": { "width": 240, "min": 200, "max": 320 },
    "input": { "minHeight": 56, "maxHeight": 160, "panelWidth": 640 },
    "content": { "maxWidth": 720 },
    "panel": { "compactW": 750, "compactH": 430, "expandW": 900, "expandH": 580 },
    "window": { "defaultW": 1100, "defaultH": 720, "minW": 900, "minH": 560 },
    "floating": { "width": 560 },
    "icon": { "small": 14, "row": 16, "card": 20, "empty": 32 },
    "menuBarPopover": { "width": 280 },
    "settingsWindow": { "navWidth": 160, "width": 480, "height": 600 }
  }
}
