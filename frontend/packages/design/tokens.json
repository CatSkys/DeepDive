{
  "$schema": "https://dshmini.local/schema/tokens.json",
  "version": 4,
  "meta": {
    "note": "DSHmini 设计 token 唯一事实源（docs/UI-SPEC.md §1）。生成 Web 端 CSS Variables 与原生端 Tokens.swift。任何一端手写数值即违规。v4：黑白主题（无强调色/品牌色），状态靠符号+亮度；仅 diff 增删保留绿红内容层语义色；图标库锁定 Lucide（stroke 1.5/round/单色 currentColor），语义映射见 UI-SPEC §1.6.1；暗色为默认。",
    "source": "docs/UI-SPEC.md"
  },
  "icon": {
    "library": "lucide-react",
    "stroke": { "width": 1.5, "linecap": "round", "linejoin": "round", "fill": "none" },
    "color": { "default": "text.secondary", "active": "text.primary" }
  },
  "color": {
    "text": {
      "primary":   { "light": "#1A1A1A", "dark": "#F2F2F3" },
      "secondary": { "light": "#626262", "dark": "#9E9EA3" },
      "tertiary":  { "light": "#98989D", "dark": "#6E6E73" },
      "disabled":  { "light": "#C4C4C8", "dark": "#454548" }
    },
    "surface": {
      "panel":     { "light": "rgba(255,255,255,.72)", "dark": "rgba(14,14,16,.62)" },
      "raised":    { "light": "rgba(255,255,255,.88)", "dark": "rgba(34,34,38,.70)" },
      "input":     { "light": "rgba(0,0,0,.05)",       "dark": "rgba(255,255,255,.045)" },
      "selected":  { "light": "rgba(0,0,0,.10)",       "dark": "rgba(255,255,255,.14)" },
      "inverted":  { "light": "#FFFFFF",               "dark": "#2A2A2E" }
    },
    "border": {
      "default": { "light": "rgba(0,0,0,.11)",  "dark": "rgba(255,255,255,.09)" },
      "strong":  { "light": "rgba(0,0,0,.22)",  "dark": "rgba(255,255,255,.18)" },
      "gloss":   { "light": "rgba(255,255,255,.55)", "dark": "rgba(255,255,255,.16)" }
    },
    "focus": { "light": "#000000", "dark": "#FFFFFF" },
    "status": {
      "running": { "light": "#8A8A8E",  "dark": "#D8D8DC" },
      "waiting": { "light": "#1A1A1A",  "dark": "#F2F2F3" },
      "failed":  { "light": "#3A3A3E",  "dark": "#E4E4E8" },
      "done":    { "light": "#6E6E73",  "dark": "#9E9EA3" },
      "danger":  { "light": "#1A1A1A",  "dark": "#F2F2F3" }
    },
    "diff": {
      "add": { "light": "#0F7A3D", "dark": "#3FCC7A" },
      "del": { "light": "#C22F2F", "dark": "#E5534B" }
    },
    "terminal": { "bg": { "light": "#F2F2F4", "dark": "#1A1A1D" } },
    "overlay":  { "scrim": { "light": "rgba(0,0,0,.35)", "dark": "rgba(0,0,0,.55)" } }
  },
  "font": {
    "ui": { "family": "-apple-system, \"PingFang SC\", \"SF Pro Text\", sans-serif" },
    "mono": { "family": "\"SF Mono\", ui-monospace, Menlo, monospace" },
    "size": {
      "caption": { "px": 11, "lineHeight": 14, "weight": 500 },
      "small":   { "px": 12, "lineHeight": 16, "weight": 500 },
      "body":    { "px": 13, "lineHeight": 18, "weight": 400 },
      "title":   { "px": 15, "lineHeight": 20, "weight": 600 },
      "hero":    { "px": 20, "lineHeight": 24, "weight": 600 },
      "input":   { "px": 16, "lineHeight": 22, "weight": 400 }
    },
    "tabularNums": true
  },
  "space": { "s1": 4, "s2": 8, "s3": 12, "s4": 16, "s5": 20, "s6": 24 },
  "radius": {
    "keycap": 6,
    "control": 10,
    "input": 14,
    "card": 14,
    "floating": 20,
    "panel": 16
  },
  "border": {
    "width": 1,
    "focus": { "width": 2, "color": "focus" }
  },
  "shadow": {
    "floating": {
      "light": "0 16px 48px rgba(0,0,0,.35)",
      "dark": "0 16px 48px rgba(0,0,0,.50)"
    }
  },
  "size": {
    "row": { "compact": 28, "standard": 36 },
    "sidebar": { "width": 240, "min": 200, "max": 320 },
    "input": { "minHeight": 56, "maxHeight": 160, "panelWidth": 640 },
    "content": { "maxWidth": 720 },
    "panel": { "compactW": 750, "compactH": 430, "expandW": 900, "expandH": 580 },
    "window": { "defaultW": 1100, "defaultH": 720, "minW": 900, "minH": 560 },
    "floating": { "width": 560 },
    "icon": { "small": 14, "row": 16, "card": 20, "empty": 32 },
    "menuBarPopover": { "width": 280 },
    "settingsWindow": { "navWidth": 160, "width": 480, "height": 600 }
  },
  "motion": {
    "control": { "ms": 120, "easing": "cubic-bezier(.2,0,0,1)" },
    "panelShow": { "ms": 200, "easing": "cubic-bezier(.2,0,0,1)", "translateY": 8, "scaleFrom": 0.98 },
    "panelHide": { "ms": 120, "easing": "cubic-bezier(.2,0,0,1)" },
    "floating": { "ms": 160, "easing": "cubic-bezier(.2,0,0,1)", "scaleFrom": 0.96 },
    "dotPulse": { "ms": 1200 }
  }
}
